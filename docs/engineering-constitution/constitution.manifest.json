  "canonical_text_policy": {
    "roots": [
      "docs/engineering-constitution"
    ],
    "extensions": [
      ".md",
      ".json"
    ],
    "ascii_only": true
  },
  "source_text_policy": {
    "roots": [
      "src",
      "scripts",
      "tests",
      "config",
      "pocs/elastic-multi-gpu-inference/manifests",
      ".github"
    ],
    "extensions": [
      ".py",
      ".js",
      ".html",
      ".yaml",
      ".yml",
      ".json"
    ],
    "forbid_non_ascii_letters": true,
    "forbidden_code_points": [
      "U+00A1",
      "U+00BF",
      "U+00C1",
      "U+00C9",
      "U+00CD",
      "U+00D1",
      "U+00D3",
