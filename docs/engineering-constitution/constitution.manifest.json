{
  "schema_version": "1.0.0",
  "governance_phase": 1,
  "repository_baseline": {
    "branch": "origin/main",
    "commit": "eda8c880ba94b4922b4e70cbb0331542ae4884f9"
  },
  "enforcement": {
    "required_files": [
      ".python-version",
      "pyproject.toml",
      "uv.lock",
      ".github/workflows/engineering-governance.yml",
      "docs/engineering-constitution/constitution.manifest.json",
      "scripts/validate_engineering_constitution.py",
      "scripts/validate_mutation_adjudications.py",
      "tests/governance/test_engineering_constitution.py",
      "tests/phase1/mutation-adjudications.json"
    ],
    "ci_workflow": ".github/workflows/engineering-governance.yml",
    "required_ci_commands": [
      "uv sync --frozen",
      "uv lock --check",
      "uv run ruff check src/pocgpu tests/phase1 tests/build tests/migration",
      "uv run mypy src/pocgpu tests/phase1",
      "uv run pytest tests/build tests/migration tests/phase1 --cov=pocgpu.domain --cov-branch",
      "uv run mutmut run",
      "uv run python scripts/validate_mutation_adjudications.py",
      "uv build --no-sources",
      "uv run pip-audit --local --progress-spinner off",
      "python3 scripts/validate_engineering_constitution.py",
      "python3 -m unittest discover -s tests/governance -p 'test_*.py'"
    ]
  },
