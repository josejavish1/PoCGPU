      "U+00E9",
      "U+00ED",
      "U+00F1",
      "U+00F3",
      "U+00FA",
      "U+00FC"
    ],
    "localized_resources": [
      "config/locales.json"
    ],
    "legacy_ratchet": {
      "expires_before_phase": 1,
      "files": []
    }
  }
