  "table_contracts": [
    {
      "name": "requirement ownership",
      "path": "docs/engineering-constitution/REQUIREMENTS_TRACEABILITY.md",
      "registry": "requirements",
      "key_column": "ID",
      "required_columns": [
        "ID",
        "Requirement",
        "Planned phase",
        "Verification"
      ],
      "constraints": [
        {
          "column": "Planned phase",
          "type": "phase_range"
        }
      ]
    },
    {
      "name": "formula governance",
      "path": "docs/engineering-constitution/CALCULATION_CONSTITUTION.md",
      "registry": "formulas",
      "key_column": "Formula ID",
      "required_columns": [
        "Formula ID",
        "Version",
        "Owning phase",
        "Approval state"
      ],
      "constraints": [
        {
          "column": "Version",
          "type": "pattern",
          "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+"
        },
        {
          "column": "Owning phase",
          "type": "phase_range"
        },
        {
          "column": "Approval state",
          "type": "allowed_values",
          "values": [
            "DEFINED"
          ]
        }
      ]
    },
    {
      "name": "risk ownership",
      "path": "docs/engineering-constitution/RISK_REGISTER.md",
      "registry": "risks",
      "key_column": "ID",
      "required_columns": [
        "ID",
        "Failure mode",
        "Effect",
        "Severity",
        "Likelihood",
        "Preventive control",
        "Detection control",
        "Owning phase"
      ],
      "constraints": [
        {
          "column": "Owning phase",
          "type": "phase_range"
        }
      ]
    }
  ],
